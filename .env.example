# ─── Plantilla de variables de entorno ───
# Copiar este archivo a `.env` (sin el .example) y completar los valores.
# En Render, cargar estas mismas variables en Environment > Secret Files / Env Vars.

# Clave secreta de Django (obligatoria)
SECRET_KEY=

# True solo en desarrollo. En producción: False (o no definirla)
DEBUG=False

# Dominios permitidos, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1,mi-forrajeria.onrender.com

# Orígenes confiables para CSRF (producción)
CSRF_TRUSTED_ORIGINS=https://mi-forrajeria.onrender.com

# URL de la base de datos (Render la inyecta automáticamente si usás su Postgres)
DATABASE_URL=

# MercadoPago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail SMTP)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
NOTIFICATION_EMAIL=

# Brevo: envío por HTTPS. Obligatorio en Render free (bloquea los puertos SMTP).
# Crear la clave en Brevo > SMTP & API > API Keys.
BREVO_API_KEY=
# Remitente verificado en Brevo (si se deja vacío usa EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=
